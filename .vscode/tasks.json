{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build Kernel",
            "type": "shell",
            "command": "powershell",
            "args": ["-ExecutionPolicy", "Bypass", "-File", "build.ps1"],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": []
        },
        {
            "label": "Build ISO",
            "type": "shell",
            "command": "powershell",
            "args": ["-ExecutionPolicy", "Bypass", "-File", "build.ps1", "-Iso"],
            "group": "build",
            "problemMatcher": []
        },
        {
            "label": "Build & Run (kernel)",
            "type": "shell",
            "command": "powershell",
            "args": ["-ExecutionPolicy", "Bypass", "-File", "build.ps1", "-Run"],
            "group": "build",
            "problemMatcher": []
        },
        {
            "label": "Build ISO & Run",
            "type": "shell",
            "command": "powershell",
            "args": ["-ExecutionPolicy", "Bypass", "-File", "build.ps1", "-Iso", "-Run"],
            "group": "build",
            "problemMatcher": []
        },
        {
            "label": "Clean",
            "type": "shell",
            "command": "powershell",
            "args": ["-ExecutionPolicy", "Bypass", "-File", "build.ps1", "-Clean"],
            "group": "build",
            "problemMatcher": []
        }
    ]
}
